APP_NAME=GymFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymfinder
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=cloudinary
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@gymfinder.app"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# --- Cloudinary ---
CLOUDINARY_URL=cloudinary://key:secret@cloud
CLOUDINARY_UPLOAD_PRESET=

# --- Meilisearch ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Razorpay (DUMMY / test) ---
RAZORPAY_KEY=rzp_test_dummy_key
RAZORPAY_SECRET=rzp_test_dummy_secret
RAZORPAY_WEBHOOK_SECRET=whsec_dummy

# --- Firebase Cloud Messaging (dummy) ---
FIREBASE_CREDENTIALS=storage/app/firebase.json
FCM_SERVER_KEY=

# --- Nominatim (OpenStreetMap) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GymFinder/1.0

# --- Dummy OAuth ---
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/google/callback

# --- OTP (dummy provider) ---
OTP_PROVIDER=dummy
OTP_TTL_SECONDS=300
